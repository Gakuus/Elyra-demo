# Entorno / credenciales
.env

# phpMyAdmin (instalación local de terceros)
phpmyadmin/

# Backups de base de datos (contienen datos reales)
database/backups/

# Archivos generados en runtime
storage/qrcodes/*
public/uploads/*
!storage/qrcodes/.gitkeep
!public/uploads/.gitkeep

# PDFs de documentos subidos por los usuarios (contenido real, no va al repo)
storage/docs/*

# Planificación interna del equipo (cronograma y sprints)
docs/

# Sistema
.DS_Store
Thumbs.db
