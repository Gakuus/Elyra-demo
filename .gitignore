# Entorno / credenciales
.env
.env.*
!.env.example

# phpMyAdmin (instalación local de terceros)
phpmyadmin/

# Backups de base de datos (contienen datos reales)
database/backups/
database.tar.gz

# Archivos generados en runtime
storage/qrcodes/*
storage/route-cache/*
storage/geocode-cache/*
storage/geoapify-cache/*
storage/overpass-cache/*
storage/rate-limit/*
storage/logs/*
public/uploads/*
!storage/qrcodes/.gitkeep
!storage/geocode-cache/.gitkeep
!storage/rate-limit/.gitkeep
!storage/logs/.gitkeep
!public/uploads/.gitkeep

# PDFs de documentos subidos por los usuarios (contenido real, no va al repo)
storage/docs/*

# Planificación interna del equipo (cronograma y sprints)
docs/

# Auditoría de seguridad: documenta paso a paso cómo obtener las credenciales
# de la base de datos y romper la aplicación. NUNCA va al repositorio.
AUDITORIA_SEGURIDAD.md

