# Plantilla de variables de entorno. Copiar a .env y completar los valores.
# .env no se versiona: nunca subir credenciales reales al repositorio.

APP_URL=https://tu-dominio/proyectos/elyra
APP_TIMEZONE=America/Montevideo
APP_SECRET=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=elyra
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=

GEOAPIFY_API_KEY=
GEOPROVIDER=geoapify

# Correo saliente (recuperación de contraseña) por SMTP de Gmail.
# MAIL_PASSWORD es una "contraseña de aplicación" de Google, no la de la cuenta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Elyra