# Plantilla de variables de entorno. Copiar a .env y completar los valores.
# .env no se versiona: nunca subir credenciales reales al repositorio.

APP_URL=https://tu-dominio/proyectos/elyra
APP_TIMEZONE=America/Montevideo
APP_SECRET=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=elyra
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=

GEOAPIFY_API_KEY=
GEOPROVIDER=geoapify

# Chatbot de Elyra (IA gratuita). La clave se usa solo del lado del servidor.
# CHAT_PROVIDER=groq | openrouter | gemini | openai | custom
# Si se deja vacío, se deduce del prefijo: gsk_ = Groq, sk-or- = OpenRouter,
# AIza = Gemini. Sin clave, el widget avisa que no está configurado.
CHAT_PROVIDER=
CHAT_API_KEY=
CHAT_MODEL=
CHAT_BASE_URL=

# Raíz del almacenamiento privado (PDFs, logs, rate-limit y cachés).
# Vacío = <raíz del proyecto>/storage (en el servidor: /var/www/elyra/storage).
# Si www-data solo puede escribir en otra ruta, ponerla acá (absoluta).
STORAGE_PATH=

# Correo saliente (recuperación de contraseña) por SMTP de Gmail.
# MAIL_PASSWORD es una "contraseña de aplicación" de Google, no la de la cuenta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Elyra